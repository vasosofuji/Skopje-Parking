<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/skopje_parking_widget_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="16dp"
  android:paddingEnd="10dp"
  android:paddingTop="8dp"
  android:paddingBottom="8dp">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/skopje_parking_widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/skopje_parking_widget_empty"
      android:textColor="#392C25"
      android:textSize="17sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/skopje_parking_widget_detail"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#B3392C25"
      android:textSize="13sp"
      android:visibility="gone" />
  </LinearLayout>

  <TextView
    android:id="@+id/skopje_parking_widget_action"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:layout_marginStart="10dp"
    android:background="@drawable/skopje_parking_widget_button"
    android:gravity="center"
    android:maxLines="1"
    android:minWidth="72dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:text="@string/skopje_parking_widget_open"
    android:textColor="#FFFFFF"
    android:textSize="15sp"
    android:textStyle="bold" />
</LinearLayout>

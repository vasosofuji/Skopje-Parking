  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --localhost",
    "api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "import:operator": "tsx scripts/import-operator.ts",
    "build:function": "node scripts/build-function.mjs",
    "deploy:function": "node scripts/build-function.mjs && npx supabase@latest functions deploy api --no-verify-jwt",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-database.ts",
    "db:import-local": "node --env-file-if-exists=.env --import tsx scripts/copy-sqlite-to-postgres.ts"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
}
